{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "primitives-org-ai",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // the theme script is inlined from its source text; kept names would add __name() calls the browser lacks
  "keep_names": false,
  "routes": [
    {
      "pattern": "primitives.org.ai/*",
      "zone_name": "primitives.org.ai"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "primitives-org-ai"
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}
