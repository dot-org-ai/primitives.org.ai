{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eval-workers-do",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "account_id": "b6641681fe423910342b9ffa1364c76d",

  // Routes - zone route for workers.do domain
  "routes": [
    { "pattern": "eval.workers.do/*", "zone_name": "workers.do" }
  ],

  // Keep workers.dev enabled for testing
  "workers_dev": true,

  // Worker loader for dynamic sandbox execution
  "worker_loaders": [
    { "binding": "loader" }
  ],

  // The SandboxHost Durable Object (SQLite): owns the per-sandbox facets of
  // `evaluate({ facet, sandboxId })`; exported from src/index.ts
  "durable_objects": {
    "bindings": [{ "name": "SANDBOX_HOST", "class_name": "SandboxHost" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SandboxHost"] }],

  // Bundle configuration to resolve workspace package
  "alias": {
    "ai-evaluate": "../dist/index.js",
    "ai-evaluate/worker": "../dist/worker.js"
  }
}
