{
  "name": "ai-evaluate",
  "version": "2.4.0",
  "description": "Runtime sandboxed execution of AI-generated code in V8 isolates",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./node": {
      "import": "./dist/node.js",
      "types": "./dist/node.d.ts"
    },
    "./repl": {
      "import": "./dist/repl.js",
      "types": "./dist/repl.d.ts"
    },
    "./static": {
      "import": "./dist/static/index.js",
      "types": "./dist/static/index.d.ts"
    },
    "./static/index.mjs": "./public/index.mjs",
    "./static/capnweb.mjs": "./public/capnweb.mjs",
    "./static/scaffold.mjs": "./public/scaffold.mjs"
  },
  "files": [
    "dist",
    "public"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:host-worker && npm run build:static",
    "build:host-worker": "npx tsx scripts/build-host-worker.ts",
    "build:static": "npx tsx scripts/build-static.ts",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run && vitest run --config vitest.workers.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf dist public",
    "test:node": "vitest run",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "build:transform": "npx tsx scripts/build-transform-bundle.ts"
  },
  "dependencies": {
    "capnweb": "^0.2.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@vitest/coverage-v8": "^4.1.0",
    "sucrase": "^3.35.1",
    "tsx": "^4.7.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.39.0"
  },
  "optionalDependencies": {
    "miniflare": "^5.20260907.0-alpha"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "ai",
    "sandbox",
    "evaluate",
    "cloudflare",
    "workers",
    "miniflare",
    "primitives"
  ],
  "license": "MIT"
}
